Algoritmo EDAD
	//REALIZAR UN PROGRAMA QUE CAPTURE LA EDAD DE UNA PEERSONA Y DETERMINE SI ES MAYOR  O MENOR
	Escribir "PROGRAMA QUE DETERMINA LA MAYORIA DE EDAD DE UNA PERSONA"
	Escribir "BUENAS"
	ESCRIBIR "DIGITE SU NOMBRE"
	Leer NOMBRE
	Escribir "DIGITE SU EDAD"
	Leer EDAD1
	Leer EDAD1 
	   SI EDAD1 >= 18 Entonces
		   Escribir "LA PERSONA ES MAYOR DE EDAD1"
	   SiNo
		   Escribir "LA PERSONA ES MENOR DE EDAD1"
	   FinSi
FinAlgoritmo
